# ProofLens environment configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# OpenRouter API key
# Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Qwen model identifier on OpenRouter
# Default fallback: qwen/qwen-2.5-72b-instruct
QWEN_MODEL=qwen/qwen-2.5-72b-instruct

# OpenRouter base URL
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional metadata headers
OPENROUTER_HTTP_REFERER=https://github.com/ProofLens
OPENROUTER_APP_NAME=ProofLens
